---
import type { CollectionEntry } from 'astro:content';
const {posts, preview = false} = Astro.props as {posts: CollectionEntry<'essays'>[]; preview?:boolean};
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const date=(d:Date)=>d.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
---
<div class="post-list">
  {posts.length === 0 ? <div class="empty-state"><p>No essays published yet.</p><p>New writing will appear here, with the newest posts first.</p></div> : posts.map(post => (
    <article class="post-item">
      <div class="post-date">{preview ? 'DRAFT · NOT PUBLISHED' : date(post.data.pubDate)}</div>
      <h3>{preview ? post.data.title : <a href={`${root}/essays/${post.id}/`}>{post.data.title}</a>}</h3>
      <p class="post-summary">{post.data.description}</p>
    </article>
  ))}
</div>
