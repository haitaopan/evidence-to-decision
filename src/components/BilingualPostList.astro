---
import type { EssayGroup, LanguageView } from '../lib/bilingual';
import { selectedEdition } from '../lib/bilingual';
import readership from '../data/readership.json';
const {groups, view='all'} = Astro.props as {groups:EssayGroup[];view?:LanguageView};
const root = import.meta.env.BASE_URL.replace(/\/$/,'');
const fmtDate = (d:Date) => d.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
const counts = new Map((readership.pages || []).map(p=>[p.path,p.views]));
const ready = readership.status === 'ready';
const linkTo = (id:string) => `${root}/essays/${id}/`;
---
<div class="post-list">
{groups.length === 0 ? <div class="empty-state"><p>{view==='zh'?'暂无中文文章。':view==='en'?'No English posts yet.':'No posts yet.'}</p></div> :
 groups.map(group => {
   const edition = selectedEdition(group, view)!;
   const path = `/essays/${edition.id}/`;
   const views = ready ? counts.get(path) : undefined;
   return <article class="post-item">
     <div class="post-date">{fmtDate(edition.data.pubDate)}
       {views !== undefined && <span class="post-public-views" title={`Recorded through ${readership.through}`}> · {views.toLocaleString('en-US')} views</span>}
     </div>
     <h3 lang={edition.data.lang==='zh'?'zh-CN':'en'}><a href={linkTo(edition.id)}>{edition.data.title}</a></h3>
     <p class="post-summary" lang={edition.data.lang==='zh'?'zh-CN':'en'}>{edition.data.description}</p>
     <nav class="post-language-links" aria-label="Available article languages">
       {group.en && <a href={linkTo(group.en.id)} lang="en" class:list={[{current:edition.id===group.en.id}]}>English</a>}
       {group.en && group.zh && <span aria-hidden="true">·</span>}
       {group.zh && <a href={linkTo(group.zh.id)} lang="zh-CN" class:list={[{current:edition.id===group.zh.id}]}>中文版</a>}
     </nav>
   </article>;
 })}
</div>
