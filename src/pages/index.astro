---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const seeds=[
{title:'Before the Method',subtitle:'Define the Decision First',tag:'Clinical trials · Decision making',excerpt:'A method can be statistically elegant and still answer the wrong question.'},
{title:'When “Not Yet” Becomes “No”',subtitle:'Early futility and delayed response',tag:'Evidence timing · Trial monitoring',excerpt:'When does immature evidence justify stopping—and when does it justify waiting?'},
{title:'Who Can Respond?',subtitle:'Measurable disease and the hidden denominator',tag:'Endpoints · Phase II trials',excerpt:'A response rate depends on more than the responses in its numerator.'}
];
---
<BaseLayout>
<section class="hero"><div class="eyebrow">A scientist’s notebook</div><h1>Evidence<br />to Decision<span style="color:var(--accent)">.</span></h1><p class="lede">Clinical trials, evidence, and the decisions between them.</p><p class="byline">HAITAO PAN, PhD · BIOSTATISTICIAN & CLINICAL-TRIAL METHODOLOGIST</p><p class="intro">I write about clinical trials, oncology, uncertainty, and a question that sits behind nearly every study: <em>What evidence do we need—and when is it enough to act?</em></p><a class="feature-link" href={`${base}/essays/`}>Explore essays →</a></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Writing</div><h2>Essays in preparation</h2></div><a class="textlink" href={`${base}/essays/`}>All essays →</a></div><div class="articles">{seeds.map(s=><article class="article"><div class="meta">{s.tag}</div><h3>{s.title}</h3><strong style="font-size:13px;font-weight:500">{s.subtitle}</strong><p>{s.excerpt}</p><span class="meta">DRAFT · NOT PUBLISHED</span></article>)}</div></section>
<section class="section"><div class="eyebrow">Three recurring questions</div><div class="questions"><p>What decision are we actually trying to make?</p><p>What evidence is entitled to inform it?</p><p>When is the evidence sufficient to act?</p></div></section>
<section class="section two-col"><div><div class="eyebrow">Research themes</div><h2>Ideas worth returning to.</h2><p>Clinical trial decisions · External and counterfactual evidence · Rare diseases and pediatric oncology · Estimands and endpoints · AI and clinical research</p><a class="textlink" href={`${base}/research/`}>Explore research →</a></div><div><div class="eyebrow">Spoken reflections</div><h2>Evidence to Decision Podcast</h2><p>A companion format for conversations and short reflections. Essays are the place where ideas take a durable, citable form.</p><a class="textlink" href={`${base}/podcast/`}>About the podcast →</a></div></section>
</BaseLayout>
