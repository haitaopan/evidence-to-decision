---
import BaseLayout from '../layouts/BaseLayout.astro';
import BilingualPostList from '../components/BilingualPostList.astro';
import LanguageTabs from '../components/LanguageTabs.astro';
import { sortedGroups } from '../lib/bilingual';
import TopicSidebar from '../components/TopicSidebar.astro';
import ReadershipPanel from '../components/ReadershipPanel.astro';
import { getCollection } from 'astro:content';
const published=await getCollection('essays',({data})=>!data.draft);
const groups=sortedGroups(published);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout>
<div class="intro">
<h1>Evidence to Decision</h1>
<p class="owner-label">Haitao Pan’s Blog</p>
<p class="tagline">Clinical trials, evidence, and the decisions between them.</p>
</div>
<div class="blog-layout">
  <section class="blog-main" aria-labelledby="latest-heading">
    <div class="feed-heading"><h2 id="latest-heading">Latest posts</h2></div>
    <LanguageTabs context="home" active="all"/>
    <BilingualPostList groups={groups.slice(0,10)}/>
    {groups.length>10 && <a class="archive-link" href={`${base}/essays/`}>View all posts →</a>}
  </section>
  <TopicSidebar posts={published}/>
</div>
<ReadershipPanel compact={true} />
</BaseLayout>
