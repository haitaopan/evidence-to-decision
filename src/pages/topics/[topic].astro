---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BilingualPostList from '../../components/BilingualPostList.astro';
import LanguageTabs from '../../components/LanguageTabs.astro';
import { sortedGroups } from '../../lib/bilingual';
import TopicSidebar from '../../components/TopicSidebar.astro';
import { getCollection } from 'astro:content';
import { TOPICS,topicSlug } from '../../lib/topics';
export function getStaticPaths(){return TOPICS.map(topic=>({params:{topic:topicSlug(topic)},props:{topic}}));}
const {topic}=Astro.props;
const all=await getCollection('essays',({data})=>!data.draft);
const posts=all.filter(e=>e.data.topics.includes(topic));
const groups=sortedGroups(posts);
const slug=topicSlug(topic);
---
<BaseLayout title={topic}>
<div class="archive-intro"><p class="breadcrumb"><a href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/essays/`}>All essays</a> / Topics</p><h1>{topic}</h1></div>
<div class="blog-layout"><section class="blog-main" aria-label={`Essays on ${topic}`}><LanguageTabs context="topic" topicSlug={slug} active="all"/><BilingualPostList groups={groups}/></section><TopicSidebar posts={all} activeTopic={topic}/></div>
</BaseLayout>
