---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TopicSidebar from '../../components/TopicSidebar.astro';
import { getCollection } from 'astro:content';
import { TOPICS,topicSlug } from '../../lib/topics';
export function getStaticPaths(){return TOPICS.map(topic=>({params:{topic:topicSlug(topic)},props:{topic}}));}
const {topic}=Astro.props;
const all=(await getCollection('essays',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()||a.data.title.localeCompare(b.data.title));
const posts=all.filter(e=>e.data.topics.includes(topic));
---
<BaseLayout title={topic}>
<div class="archive-intro"><p class="breadcrumb"><a href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/essays/`}>All essays</a> / Topics</p><h1>{topic}</h1></div>
<div class="blog-layout"><section class="blog-main" aria-label={`Essays on ${topic}`}><PostList posts={posts}/></section><TopicSidebar posts={all} activeTopic={topic}/></div>
</BaseLayout>
