---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const essays=(await getCollection('essays',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Essays"><header class="page-head"><div class="eyebrow">Writing</div><h1>Essays</h1><p>Thoughts about clinical evidence, uncertainty, and the decisions that research is meant to inform.</p></header><section class="section"><div class="articles">{essays.length===0 ? <p>No essays published yet. The first pieces are in preparation.</p> : essays.map(e=><article class="article"><div class="meta">{e.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})} · {e.data.topics.join(' · ')}</div><h3><a href={`${base}/essays/${e.id}/`}>{e.data.title}</a></h3><p>{e.data.description}</p></article>)}</div></section></BaseLayout>
