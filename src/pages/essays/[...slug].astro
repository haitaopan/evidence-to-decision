---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection,render } from 'astro:content';
import { topicSlug } from '../../lib/topics';
import EssayComments from '../../components/EssayComments.astro';
import readership from '../../data/readership.json';
export async function getStaticPaths(){
 const entries=await getCollection('essays',({data})=>!data.draft);
 return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const date=(d:Date)=>d.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
const canonical=new URL(Astro.url.pathname,Astro.site||Astro.url.origin).toString();
const views=readership.status === 'ready' ? (readership.pages.find(p=>p.path===`/essays/${entry.id}/`)?.views ?? null) : null;
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
<article class="essay-wrap">
<p class="backlink"><a href={`${root}/essays/`}>← All posts</a></p>
<div class="post-date">{date(entry.data.pubDate)}{entry.data.updatedDate && ` · Updated ${date(entry.data.updatedDate)}`}</div>
<h1>{entry.data.title}</h1><p class="essay-description">{entry.data.description}</p>
<p class="post-byline">By Haitao Pan, PhD {views !== null && <span class="essay-public-views" title={`Recorded through ${readership.through}`}> · {views.toLocaleString("en-US")} measured views</span>}</p>
<div class="essay-topics" aria-label="Essay topics">{entry.data.topics.map(topic=><a href={`${root}/topics/${topicSlug(topic)}/`}>{topic}</a>)}</div>
<div class="prose"><Content /></div>
<section class="reprint-note" aria-label="Attribution and sharing">
<strong>Sharing and attribution</strong>
<p>If you quote, share, or republish this article, please credit <strong>Haitao Pan, PhD</strong>, name <em>Evidence to Decision</em> as the source, and include a link to <a href={canonical}>the original article</a>.</p>
</section>
<EssayComments pageId={entry.id} pageTitle={entry.data.title} pageUrl={canonical} />
</article></BaseLayout>
