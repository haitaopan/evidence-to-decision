---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
const {title='Evidence to Decision',description='Clinical trials, evidence, and the decisions between them.'}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const path=(p:string)=>`${base}${p}`;
const canonical=new URL(Astro.url.pathname,Astro.site||Astro.url.origin).toString();
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#ffffff"/><meta name="description" content={description}/>
<meta name="author" content="Haitao Pan, PhD"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Evidence to Decision"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/>
<link rel="canonical" href={canonical}/><link rel="icon" href={path('/favicon.svg')} type="image/svg+xml"/>
<link rel="alternate" type="application/rss+xml" title="Evidence to Decision RSS" href={path('/rss.xml')}/>
<title>{title === 'Evidence to Decision' ? title+' | Haitao Pan, PhD' : title+' | Evidence to Decision'}</title>
</head><body><a class="skip" href="#content">Skip to content</a><div class="site-shell">
<header class="top"><a class="brand" href={path('/')} aria-label="Evidence to Decision home">Evidence to Decision</a>
<nav aria-label="Primary navigation"><a href={path('/')}>Home</a><a href={path('/essays/')}>Archive</a><a href={path('/about/')}>About</a><a href={path('/subscribe/')}>Subscribe</a><a href={path('/readership/')}>Readership</a></nav>
</header><main id="content"><slot /></main>
<footer><div>© {new Date().getFullYear()} Haitao Pan, PhD · Please credit the author and link to the original article when sharing or republishing.<div>Views are personal and do not necessarily represent those of my employer or collaborators.</div></div>
<div class="footer-links"><a href={path('/readership/')}>Readership</a><a href={path('/privacy/')}>Privacy</a><button type="button" class="analytics-settings-link" data-open-analytics-settings>Cookie settings</button><a href={path('/subscribe/')}>Subscribe</a><a href={path('/rss.xml')}>RSS</a><a href="https://www.stjude.org/research/labs/pan-lab.html" target="_blank" rel="noopener noreferrer">Institutional Profile</a><a href="https://www.linkedin.com/in/haitao-pan-05578a189" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://orcid.org/0000-0003-4457-7349">ORCID</a></div></footer>
</div><AnalyticsConsent /></body></html>
